# Vinta Environment Configuration Example
# Copy to `.env` in the repository root for local development, or to
# `%APPDATA%/FreeMatrix Studios/Vinta/.env` for self-hosted builds.
# Official releases inject public client IDs via GitHub Actions Environment
# Secrets and Go `-ldflags`. Leave unset for local-only mode.

# ==============================================================================
# Updater & Local Development
# ==============================================================================
# Optional GitHub PAT for local dev (e.g. raising API rate limits or testing
# private forks). Official public releases do not embed a token.
# (Also accepted locally as VINTA_UPDATER_TOKEN or VINTA_GITHUB_TOKEN)
UPDATER_TOKEN=

# Optional custom update repository (owner/repo) or manifest URL for testing.
# Local dev only (no GitHub Secret required)
VINTA_UPDATE_REPO=
VINTA_UPDATE_URL=

# Set to 1 to hide the DevTest panel during local development.
# Local dev only (no GitHub Secret required)
VINTA_NO_DEVTEST=

# ==============================================================================
# Google Sign-In, Google Calendar & Firebase Cloud Sync (Spark Free Plan)
# ==============================================================================
# Google Desktop OAuth Client ID (RFC 8252 loopback PKCE; no client secret needed).
# GitHub Environment Secret: secrets.VINTA_GOOGLE_CLIENT_ID
VINTA_GOOGLE_CLIENT_ID=

# Firebase Web App config for Firestore Cloud Settings Sync.
# GitHub Environment Secret: secrets.VINTA_FIREBASE_API_KEY
VINTA_FIREBASE_API_KEY=
# GitHub Environment Secret: secrets.VINTA_FIREBASE_AUTH_DOMAIN
VINTA_FIREBASE_AUTH_DOMAIN=
# GitHub Environment Secret: secrets.VINTA_FIREBASE_PROJECT_ID
VINTA_FIREBASE_PROJECT_ID=

# ==============================================================================
# GitHub Developer Hub (OAuth Device Flow)
# ==============================================================================
# GitHub OAuth App Client ID with "Enable Device Flow" checked (no secret needed).
# GitHub Environment Secret: secrets.VINTA_GITHUB_CLIENT_ID
VINTA_GITHUB_CLIENT_ID=

# ==============================================================================
# Release Pipeline Only (CI / GitHub Actions Environment Secrets)
# Not required for local development; listed here for release maintainers.
# ==============================================================================
# Code signing certificate (base64 PFX) and password for Windows installer signing.
# GitHub Environment Secret: secrets.SIGNING_CERT_BASE64
# GitHub Environment Secret: secrets.SIGNING_CERT_PASSWORD
#
# Winget package submission PAT used by .github/workflows/release.yml.
# GitHub Environment Secret: secrets.WINGET_TOKEN
